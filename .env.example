# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values for your local environment.
#   cp .env.example .env
# The real .env file is git-ignored on purpose - do not commit credentials.
# ---------------------------------------------------------------------------

# --- PostgreSQL (local installation, read by the backend) ---
# These are the standard libpq variables, so database\run_seeds.ps1 picks up
# the same values. Set DATABASE_URL instead if you prefer a single connection
# string, e.g. postgresql://postgres:secret@localhost:5432/savunma_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=savunma_db
PGUSER=postgres
PGPASSWORD=change-me

# --- Backend (FastAPI) ---
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# The realm the backend validates access tokens against. These have to match
# the frontend values below; they are repeated without the VITE_ prefix because
# Vite exposes every VITE_ variable to the browser, and the backend copy is
# server side configuration.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sql-ai
KEYCLOAK_CLIENT_ID=frontend
# Realm role every caller has to hold. New accounts in the sql-ai realm get it
# automatically; leave it empty to accept any signed-in account.
KEYCLOAK_REQUIRED_ROLE=app_user

# --- Frontend (Vite) ---
# These are also duplicated in frontend/.env.example, because Vite only reads
# .env files located inside the frontend/ folder.
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sql-ai
VITE_KEYCLOAK_CLIENT_ID=frontend

# --- Hosted language model behind Ask ---
# The model runs on NVIDIA's free developer endpoint rather than locally, so
# nothing has to be installed or served on this machine. The endpoint is
# OpenAI-compatible, so the base URL and model id are the only settings.
# Generate a key at https://build.nvidia.com - it is personal, so keep it in
# this git-ignored .env file and never in a tracked file.
# Verify it before wiring anything up:
#   .venv\Scripts\python.exe backend\reports\check_model.py --list-models
#   .venv\Scripts\python.exe backend\reports\check_model.py
#   .venv\Scripts\python.exe backend\reports\check_model.py --chat
NVIDIA_API_KEY=
# The flagship models share a small free capacity pool and answer 429 far more
# often than they answer a question - kimi-k3 refused every request across half
# a minute while three other models replied on the same key. The one below was
# measured as responsive and scores 20/20 on the evaluation set; override it
# with --model, or change this line, if it starts refusing.
# Also measured as responsive: openai/gpt-oss-20b (22s),
# mistralai/mistral-nemotron (40s).
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Read-only role used for generated (untrusted) SQL ---
# Created once with:
#   CREATE ROLE sqlai_readonly WITH LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE savunma_db TO sqlai_readonly;
#   GRANT USAGE ON SCHEMA public TO sqlai_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO sqlai_readonly;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#       GRANT SELECT ON TABLES TO sqlai_readonly;
#   ALTER ROLE sqlai_readonly SET statement_timeout = '5s';
#   ALTER ROLE sqlai_readonly SET default_transaction_read_only = on;
PG_READONLY_USER=sqlai_readonly
PG_READONLY_PASSWORD=
